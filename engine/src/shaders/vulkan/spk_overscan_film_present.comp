#version 450

// spk_overscan_film_present.comp -- the Vulkan translation of kernel ④ in
// src/shaders/overscan.metal: where there is no film -- the perforations, and
// outside the strip -- the negative's density goes to the cmy that cancels this
// film's base, so the enlarger or the scanner sees clear light.
//
// `perf_sdf` / `film_alpha` are copied from the Metal source rather than
// shared: shader includes would put a second file between the two ports, and
// this one is 60 lines.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer CmyBuf { float v[]; } cmy;
layout(set = 0, binding = 1, std430) readonly buffer ParamBuf { float v[]; } P;
layout(set = 0, binding = 2, std430) readonly buffer MetaBuf { uint v[]; } meta;
layout(set = 0, binding = 3, std430) writeonly buffer OutBuf { float v[]; } out_data;

uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

// enum OsP -- mirror of src/pipeline/overscan.cpp.
const uint P_CW = 0u, P_PX = 2u;
const uint P_A00 = 5u, P_A01 = 6u, P_A10 = 7u, P_A11 = 8u, P_CS = 9u, P_CT = 10u, P_CU = 11u, P_CV = 12u;
const uint P_FILM_W = 44u;
const uint P_PERFORATED = 83u, P_PERF_PITCH = 84u, P_PERF_W = 85u, P_PERF_H = 86u, P_PERF_EDGE = 87u,
           P_PERF_R = 88u, P_PERF_PHASE = 89u;
const uint P_HOLE_C = 90u, P_HOLE_M = 91u, P_HOLE_Y = 92u;
const uint P_PERF_SEED = 187u;
const uint P_CARRIER = 199u;

float p(uint i) { return P.v[i]; }

vec2 canvas_to_film(float x, float y) {
    const float u = (x + 0.5) * p(P_PX) - p(P_CU);
    const float v = (y + 0.5) * p(P_PX) - p(P_CV);
    return vec2(p(P_A00) * u + p(P_A01) * v + p(P_CS), p(P_A10) * u + p(P_A11) * v + p(P_CT));
}

uint hash_u(uint x) {
    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
    return x;
}
float hash_f(int i, uint seed) { return float(hash_u(uint(i) * 0x9E3779B9u ^ seed)) * (1.0 / 4294967295.0); }
float value_noise(float x, uint seed) {
    const float i0 = floor(x), f = x - i0;
    const float w = f * f * (3.0 - 2.0 * f);
    return mix(hash_f(int(i0), seed), hash_f(int(i0) + 1, seed), w);
}

// The nearest perforation's signed distance (mm, negative inside). KS holes are
// punched to tight tolerances, not drawn: each hole sits a few microns off the
// ideal pitch and row, is a few microns off size, its corners are not all the
// same, and the punched edge is not a perfect line. `hole` returns the hole's
// own hash (row and index) for the scan's dust.
float perf_sdf(vec2 st, out uint hole) {
    const float W = p(P_FILM_W);
    const float pitch = p(P_PERF_PITCH), ph = p(P_PERF_PHASE);
    // The nearest hole: the cell is centred on it.
    const float k = floor((st.x - ph - 0.5 * p(P_PERF_W)) / pitch + 0.5);
    const bool top = st.y < 0.5 * W;
    const uint seed = uint(p(P_PERF_SEED));
    hole = hash_u(uint(int(k) * 2 + (top ? 0 : 1)) * 0x9E3779B9u ^ seed);
    const int h = int(hole & 0xFFFFu);
    const float j0 = hash_f(h, seed ^ 0x1u) - 0.5, j1 = hash_f(h, seed ^ 0x2u) - 0.5;
    const float j2 = hash_f(h, seed ^ 0x3u) - 0.5, j3 = hash_f(h, seed ^ 0x4u) - 0.5;
    const float j4 = hash_f(h, seed ^ 0x5u) - 0.5;
    const float wa = p(P_PERF_W) + 0.016 * j2, hc = p(P_PERF_H) + 0.016 * j3;
    const float r = clamp(p(P_PERF_R) + 0.08 * j4, 0.3, 0.6);
    const float sc = ph + k * pitch + 0.5 * p(P_PERF_W) + 0.020 * j0;
    const float tc = (top ? p(P_PERF_EDGE) + 0.5 * p(P_PERF_H) : W - p(P_PERF_EDGE) - 0.5 * p(P_PERF_H)) + 0.024 * j1;
    const vec2 q = abs(vec2(st.x - sc, st.y - tc)) - vec2(0.5 * wa - r, 0.5 * hc - r);
    float d = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r;
    // the punched edge: each hole's own roughness, 1-4 microns
    const float rough = 0.001 + 0.003 * hash_f(h, seed ^ 0x6u);
    d += rough * (value_noise(st.x / 0.05, seed ^ 0x77u) + value_noise(st.y / 0.05, seed ^ 0x99u) - 1.0) * 2.0;
    // a burr or a chip on about one hole in four
    if (hash_f(h, seed ^ 0x7u) < 0.25) {
        const float ang = 6.2831853 * hash_f(h, seed ^ 0x8u);
        const vec2 pb = vec2(sc, tc) + vec2(cos(ang) * 0.5 * wa, sin(ang) * 0.5 * hc);
        const float sig = 0.020 + 0.030 * hash_f(h, seed ^ 0x9u);
        const float amp = (hash_f(h, seed ^ 0xAu) < 0.5 ? -1.0 : 1.0) *
                          (0.006 + 0.010 * hash_f(h, seed ^ 0xBu));
        d += amp * exp(-dot(st - pb, st - pb) / (sig * sig));
    }
    return d;
}

// How soft a perforation's edge is in a scan, as the sigma of a Gaussian edge
// in film millimetres (measured on reference_film/135, 2026-10-04).
const float kHoleEdgeSigma = 0.017;

// erf, Abramowitz and Stegun 7.1.26 (|error| < 1.5e-7).
float erf_as(float x) {
    const float t = 1.0 / (1.0 + 0.3275911 * abs(x));
    const float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-x * x);
    return x < 0.0 ? -y : y;
}

// Where there is film: 1 on the strip, 0 in the perforations and past its edges.
float film_alpha(vec2 st) {
    const float W = p(P_FILM_W), px = p(P_PX);
    float a = p(P_CARRIER) > 1.5 ? 1.0 : clamp(min(st.y, W - st.y) / px + 0.5, 0.0, 1.0);
    if (p(P_PERFORATED) > 0.5) {
        uint hole;
        // The hole's edge as the scan resolves it: the measured softness, and
        // the pixel's own width (a one-pixel ramp is a sigma of 0.31 px).
        const float sigma = sqrt(kHoleEdgeSigma * kHoleEdgeSigma + 0.0961 * px * px);
        a *= 0.5 + 0.5 * erf_as(perf_sdf(st, hole) / (1.41421356 * sigma));
    }
    return a;
}

void main() {
    const uint i = spk_global_index();
    if (i >= meta.v[0]) return;
    const uint cw = uint(p(P_CW));
    const float a = film_alpha(canvas_to_film(float(i % cw), float(i / cw)));
    const vec3 c = vec3(cmy.v[3u * i], cmy.v[3u * i + 1u], cmy.v[3u * i + 2u]);
    const vec3 hole = vec3(p(P_HOLE_C), p(P_HOLE_M), p(P_HOLE_Y));
    const vec3 r3 = a * c + (1.0 - a) * hole;
    out_data.v[3u * i] = r3.x;
    out_data.v[3u * i + 1u] = r3.y;
    out_data.v[3u * i + 2u] = r3.z;
}
