#version 450

// spk_overscan_canvas.comp -- the Vulkan translation of kernel ① (+② and the
// fog of ③) in src/shaders/overscan.metal: raw exposure on the film canvas.
//
// One parameter block `P` of 261 floats, indexed exactly as `enum OsP` in
// overscan.cpp -- that enum is the single source of the indices and this file
// mirrors it. Geometry is in film millimetres: `s` along the film, `t` across
// it, `t = 0` at the film's first long edge. A canvas pixel maps to film
// coordinates through the scan registration (a rotation and an offset), so the
// gate, the perforations and the edge print can sit a hair off square, as they
// do in a real scan.
//
// The Metal version is the reference; this is a line-for-line translation, so
// the two should be diffed rather than reasoned about separately.
layout(local_size_x = 256) in;

layout(set = 0, binding = 0, std430) readonly buffer FrameBuf { float v[]; } frame_data;
layout(set = 0, binding = 1, std430) readonly buffer ParamBuf { float v[]; } P;
layout(set = 0, binding = 2, std430) readonly buffer MetaBuf { uint v[]; } meta;
layout(set = 0, binding = 3, std430) writeonly buffer OutBuf { float v[]; } out_data;

// vulkan_gpu.cpp folds a dispatch past maxComputeWorkGroupCount[0] into rows of
// workgroups; this is the 1D index it means.
uint spk_global_index() {
    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
}

const float kPi = 3.14159265358979323846;

// enum OsP -- mirror of src/pipeline/overscan.cpp.
const uint P_CW = 0u, P_CH = 1u, P_PX = 2u, P_FW = 3u, P_FH = 4u;
const uint P_A00 = 5u, P_A01 = 6u, P_A10 = 7u, P_A11 = 8u, P_CS = 9u, P_CT = 10u, P_CU = 11u, P_CV = 12u;
const uint P_VERTICAL = 13u;
const uint P_GS0 = 14u, P_GT0 = 15u, P_GW = 16u, P_GH = 17u, P_CORNER = 18u, P_PENUMBRA = 19u;
const uint P_WOB_A = 20u;   // 4 sides x 3 harmonics
const uint P_WOB_PH = 32u;
const uint P_FILM_W = 44u, P_FOG_AMP = 45u, P_FOG_WIDTH = 46u, P_FOG_SEED = 47u, P_FOG_PERIOD = 48u;
const uint P_FOG_R = 49u, P_FOG_G = 50u, P_FOG_B = 51u;
const uint P_N_LEAKS = 52u;
const uint P_PERFORATED = 83u, P_PERF_PITCH = 84u, P_PERF_W = 85u, P_PERF_H = 86u, P_PERF_EDGE = 87u,
           P_PERF_R = 88u, P_PERF_PHASE = 89u;
const uint P_HOLE_C = 90u, P_HOLE_M = 91u, P_HOLE_Y = 92u;
const uint P_FLARE_AMP = 93u, P_FLARE_WIDTH = 94u;
const uint P_GATE_R = 95u;  // 4 corner radii: (s-,t-), (s+,t-), (s+,t+), (s-,t+)
const uint P_N_Q = 99u, P_Q = 100u;
const uint P_ROUGH_AMP = 180u, P_ROUGH_PERIOD = 181u, P_ROUGH_SEED = 182u;
const uint P_HOLES_LIGHT = 183u, P_LIGHT_R = 184u, P_LIGHT_G = 185u, P_LIGHT_B = 186u;
const uint P_PERF_SEED = 187u, P_LIGHT_FALL = 188u, P_LIGHT_DIR = 189u;
const uint P_WALL_T = 190u, P_WALL_VS = 191u, P_WALL_VT = 192u, P_WALL_PAR = 193u,
           P_BASE_R = 194u, P_BASE_G = 195u, P_BASE_B = 196u, P_WALL_GLOW = 197u, P_WALL_SCATTER = 198u;
const uint P_CARRIER = 199u;
const uint P_LEAKS = 200u;
const uint P_PAIR_ADV = 260u;
const uint kQStride = 10u;

float p(uint i) { return P.v[i]; }

vec2 canvas_to_film(float x, float y) {
    const float u = (x + 0.5) * p(P_PX) - p(P_CU);
    const float v = (y + 0.5) * p(P_PX) - p(P_CV);
    return vec2(p(P_A00) * u + p(P_A01) * v + p(P_CS), p(P_A10) * u + p(P_A11) * v + p(P_CT));
}

uint hash_u(uint x) {
    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
    return x;
}
float hash_f(int i, uint seed) { return float(hash_u(uint(i) * 0x9E3779B9u ^ seed)) * (1.0 / 4294967295.0); }
float value_noise(float x, uint seed) {
    const float i0 = floor(x), f = x - i0;
    const float w = f * f * (3.0 - 2.0 * f);
    return mix(hash_f(int(i0), seed), hash_f(int(i0) + 1, seed), w);
}

// Signed distance to a convex quad (either winding; a repeated vertex makes a
// triangle), negative inside.
float sd_quad(vec2 pt, uint base) {
    vec2 v[4] = {vec2(p(base + 0u), p(base + 1u)), vec2(p(base + 2u), p(base + 3u)),
                 vec2(p(base + 4u), p(base + 5u)), vec2(p(base + 6u), p(base + 7u))};
    float d = dot(pt - v[0], pt - v[0]);
    float sgn = 1.0;
    for (uint i = 0u, j = 3u; i < 4u; j = i, ++i) {
        const vec2 e = v[j] - v[i], w = pt - v[i];
        const float ee = dot(e, e);
        if (ee < 1e-12) continue;
        const vec2 b = w - e * clamp(dot(w, e) / ee, 0.0, 1.0);
        d = min(d, dot(b, b));
        const bool c0 = pt.y >= v[i].y, c1 = pt.y < v[j].y, c2 = e.x * w.y > e.y * w.x;
        if ((c0 && c1 && c2) || (!c0 && !c1 && !c2)) sgn = -sgn;
    }
    return sgn * sqrt(d);
}

// The gate (RFC-032 §29): per-corner radii, convex quads added to or cut from
// the opening, a machined edge's roughness, and each side's low-frequency
// wobble. Signed distance, negative inside, in mm.
float gate_sdf(vec2 st) {
    const float hw = 0.5 * p(P_GW), hh = 0.5 * p(P_GH);
    const float ds = st.x - (p(P_GS0) + hw), dt = st.y - (p(P_GT0) + hh);
    const float r = ds > 0.0 ? (dt > 0.0 ? p(P_GATE_R + 2u) : p(P_GATE_R + 1u))
                             : (dt > 0.0 ? p(P_GATE_R + 3u) : p(P_GATE_R + 0u));
    const float qs = abs(ds) - (hw - r), qt = abs(dt) - (hh - r);
    float d = length(max(vec2(qs, qt), vec2(0.0))) + min(max(qs, qt), 0.0) - r;
    uint side; float along, len;
    if (qs > qt) { side = ds > 0.0 ? 1u : 3u; along = dt + hh; len = 2.0 * hh; }
    else         { side = dt > 0.0 ? 2u : 0u; along = ds + hw; len = 2.0 * hw; }
    const float u = clamp(along / len, 0.0, 1.0);
    float w = 0.0;
    for (uint k = 0u; k < 3u; ++k)
        w += p(P_WOB_A + side * 3u + k) * sin(float(k + 1u) * kPi * u + p(P_WOB_PH + side * 3u + k));
    d -= w * sin(kPi * u);
    const uint nq = uint(p(P_N_Q));
    for (uint k = 0u; k < nq; ++k) {
        const uint q = P_Q + kQStride * k;
        float dq;
        if (abs(p(q + 9u)) > 1.5) {
            // an ellipse: centre q[0..1], radii q[2..3]; distance scaled by the
            // smaller radius, exact on the boundary, which is all a penumbra reads
            const vec2 rr = max(vec2(p(q + 2u), p(q + 3u)), vec2(1e-4));
            dq = (length((st - vec2(p(q + 0u), p(q + 1u))) / rr) - 1.0) * min(rr.x, rr.y);
        } else {
            dq = sd_quad(st, q) - p(q + 8u);
        }
        d = p(q + 9u) > 0.0 ? min(d, dq) : max(d, -dq);
    }
    if (p(P_ROUGH_AMP) > 0.0) {
        const uint seed = uint(p(P_ROUGH_SEED));
        const float per = max(p(P_ROUGH_PERIOD), 1e-3);
        d += p(P_ROUGH_AMP) * (value_noise(st.x / per, seed) + value_noise(st.y / per, seed ^ 0x5bd1e995u) - 1.0);
    }
    return d;
}

// The gate's shadow on the emulsion from a circular aperture: the lit fraction
// of a disc of radius r cut by a straight edge at signed distance d.
float penumbra_of(float d, float r) {
    if (r <= 1e-6) return d < 0.0 ? 1.0 : 0.0;
    const float u = clamp(-d / r, -1.0, 1.0);
    return 0.5 + (u * sqrt(max(1.0 - u * u, 0.0)) + asin(u)) * (1.0 / kPi);
}

vec3 sample_frame(float fx, float fy, uint fw, uint fh) {
    fx = clamp(fx, 0.0, float(fw) - 1.0);
    fy = clamp(fy, 0.0, float(fh) - 1.0);
    const uint x0 = uint(floor(fx)), y0 = uint(floor(fy));
    const uint x1 = min(x0 + 1u, fw - 1u), y1 = min(y0 + 1u, fh - 1u);
    const float ax = fx - float(x0), ay = fy - float(y0);
    const uint i00 = 3u * (y0 * fw + x0), i01 = 3u * (y0 * fw + x1);
    const uint i10 = 3u * (y1 * fw + x0), i11 = 3u * (y1 * fw + x1);
    const vec3 a = vec3(frame_data.v[i00], frame_data.v[i00 + 1u], frame_data.v[i00 + 2u]);
    const vec3 b = vec3(frame_data.v[i01], frame_data.v[i01 + 1u], frame_data.v[i01 + 2u]);
    const vec3 c = vec3(frame_data.v[i10], frame_data.v[i10 + 1u], frame_data.v[i10 + 2u]);
    const vec3 d = vec3(frame_data.v[i11], frame_data.v[i11 + 1u], frame_data.v[i11 + 2u]);
    return mix(mix(a, b, ax), mix(c, d, ax), ay);
}

void main() {
    const uint i = spk_global_index();
    if (i >= meta.v[0]) return;
    const uint cw = uint(p(P_CW));
    const vec2 st = canvas_to_film(float(i % cw), float(i / cw));
    const float W = p(P_FILM_W);
    vec3 e = vec3(0.0);
    if (p(P_CARRIER) > 1.5 || (st.y >= 0.0 && st.y <= W)) {
        // A pair: past the middle of the gap, the second exposure of the same gate.
        vec2 sg = st;
        float shift = 0.0;
        if (p(P_PAIR_ADV) > 0.0 && st.x > p(P_GS0) + 0.5 * (p(P_GW) + p(P_PAIR_ADV))) {
            shift = p(P_PAIR_ADV);
            sg.x -= shift;
        }
        const float cov = penumbra_of(gate_sdf(sg), p(P_PENUMBRA));
        if (cov > 0.0) {
            const float px = p(P_PX);
            float fx, fy;
            if (p(P_VERTICAL) < 0.5) { fx = (st.x - p(P_GS0)) / px - 0.5; fy = (st.y - p(P_GT0)) / px - 0.5; }
            else                     { fx = (p(P_GT0) + p(P_GH) - st.y) / px - 0.5; fy = (st.x - p(P_GS0)) / px - 0.5; }
            e += cov * sample_frame(fx, fy, uint(p(P_FW)), uint(p(P_FH)));
        }
        // Gate flare: the bevelled edge reflects scene light onto the film just
        // outside the frame -- a thin line that follows the scene along the edge.
        const float d_gate = gate_sdf(sg);
        if (p(P_FLARE_AMP) > 0.0 && d_gate > -0.02 && d_gate < 6.0 * p(P_FLARE_WIDTH)) {
            const float px = p(P_PX);
            const float in_s = clamp(sg.x, p(P_GS0) + 0.12, p(P_GS0) + p(P_GW) - 0.12) + shift;
            const float in_t = clamp(st.y, p(P_GT0) + 0.12, p(P_GT0) + p(P_GH) - 0.12);
            float fx, fy;
            if (p(P_VERTICAL) < 0.5) { fx = (in_s - p(P_GS0)) / px - 0.5; fy = (in_t - p(P_GT0)) / px - 0.5; }
            else                     { fx = (p(P_GT0) + p(P_GH) - in_t) / px - 0.5; fy = (in_s - p(P_GS0)) / px - 0.5; }
            const vec3 edge_light = sample_frame(fx, fy, uint(p(P_FW)), uint(p(P_FH)));
            const float prof = exp(-max(d_gate, 0.0) / p(P_FLARE_WIDTH));
            e += p(P_FLARE_AMP) * prof * edge_light;
        }
        // Edge fog: warm exposure decaying inward from each long edge, slowly
        // varying along the length; and the spool leaks, seeded blobs on an edge.
        const float d_top = max(st.y, 0.0), d_bot = max(W - st.y, 0.0);
        const uint seed = uint(p(P_FOG_SEED));
        const float period = max(p(P_FOG_PERIOD), 0.1);
        const float nz = 0.6 * value_noise(st.x / period, seed) +
                         0.4 * value_noise(st.x / (0.37 * period), seed ^ 0xA5A5A5A5u);
        float fog = p(P_FOG_AMP) * exp(-min(d_top, d_bot) / max(p(P_FOG_WIDTH), 1e-3)) * (0.3 + 0.7 * nz);
        const uint nl = uint(p(P_N_LEAKS));
        for (uint k = 0u; k < nl; ++k) {
            const uint b = P_LEAKS + 5u * k;
            const float dd = p(b + 1u) < 0.5 ? d_top : d_bot;
            const float ds = st.x - p(b);
            fog += p(b + 2u) * exp(-ds * ds / (2.0 * p(b + 3u) * p(b + 3u))) * exp(-dd / p(b + 4u));
        }
        e += fog * vec3(p(P_FOG_R), p(P_FOG_G), p(P_FOG_B));
    }
    out_data.v[3u * i] = e.x;
    out_data.v[3u * i + 1u] = e.y;
    out_data.v[3u * i + 2u] = e.z;
}
