<?xml version="1.0" encoding="utf-8"?>
<!-- Two directories leave this app: the diagnostics export under cacheDir/logs,
     which goes to a text chooser, and a finished print under cacheDir/share,
     which goes to an image chooser. Nothing else is exposed. -->
<paths>
    <cache-path name="logs" path="logs/" />
    <cache-path name="share" path="share/" />
</paths>
