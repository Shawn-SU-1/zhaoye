[Unit]
Description=Zhaoye first-party visitor analytics
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/zhaoye-analytics
Environment=PYTHONUNBUFFERED=1
Environment=ZHAOYE_ANALYTICS_DB=/var/lib/zhaoye-analytics/analytics.db
StateDirectory=zhaoye-analytics
StateDirectoryMode=0750
ExecStart=/usr/local/python3.9/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:8090 app:app
Restart=on-failure
RestartSec=3
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/zhaoye-analytics
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
