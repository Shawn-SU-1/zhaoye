                                   delta.at("scene_latitude_active").as_bool(),
-                                  delta.at("contrast_mask_active").as_bool(),
-                                  delta.at("overscan_active").as_bool(),
-                                  delta.at("date_imprint_active").as_bool());
+                                  delta.at("contrast_mask_active").as_bool(), false, false);
 }
 
 }  // namespace spk
diff --git a/engine/src/shaders/vulkan/spk_overscan_add_mask.comp b/engine/src/shaders/vulkan/spk_overscan_add_mask.comp
new file mode 100644
index 0000000..58db4de
--- /dev/null
+++ b/engine/src/shaders/vulkan/spk_overscan_add_mask.comp
@@ -0,0 +1,32 @@
+#version 450
+
+// spk_overscan_add_mask.comp -- the Vulkan translation of kernel ③ in
+// src/shaders/overscan.metal: a rasterised imprint (coverage, canvas-aligned)
+// added to the negative as exposure.
+//
+// M = {x0, y0, mw, mh, cw, ch, e_r, e_g, e_b}, all floats; the canvas is read
+// and written, so its binding is not writeonly.
+layout(local_size_x = 256) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer MaskBuf { float v[]; } mask_data;
+layout(set = 0, binding = 1, std430) readonly buffer MetaBuf { float v[]; } M;
+layout(set = 0, binding = 2, std430) readonly buffer CountBuf { uint v[]; } meta;
+layout(set = 0, binding = 3, std430) buffer CanvasBuf { float v[]; } canvas;
+
+uint spk_global_index() {
+    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
+}
+
+void main() {
+    const uint i = spk_global_index();
+    if (i >= meta.v[0]) return;
+    const uint mw = uint(M.v[2]);
+    const int x = int(M.v[0]) + int(i % mw), y = int(M.v[1]) + int(i / mw);
+    if (x < 0 || y < 0 || x >= int(M.v[4]) || y >= int(M.v[5])) return;
+    const float c = mask_data.v[i];
+    if (c <= 0.0) return;
+    const uint o = 3u * (uint(y) * uint(M.v[4]) + uint(x));
+    canvas.v[o] += c * M.v[6];
+    canvas.v[o + 1u] += c * M.v[7];
+    canvas.v[o + 2u] += c * M.v[8];
+}
diff --git a/engine/src/shaders/vulkan/spk_overscan_canvas.comp b/engine/src/shaders/vulkan/spk_overscan_canvas.comp
new file mode 100644
index 0000000..2cf9403
--- /dev/null
+++ b/engine/src/shaders/vulkan/spk_overscan_canvas.comp
@@ -0,0 +1,215 @@
+#version 450
+
+// spk_overscan_canvas.comp -- the Vulkan translation of kernel ① (+② and the
+// fog of ③) in src/shaders/overscan.metal: raw exposure on the film canvas.
+//
+// One parameter block `P` of 261 floats, indexed exactly as `enum OsP` in
+// overscan.cpp -- that enum is the single source of the indices and this file
+// mirrors it. Geometry is in film millimetres: `s` along the film, `t` across
+// it, `t = 0` at the film's first long edge. A canvas pixel maps to film
+// coordinates through the scan registration (a rotation and an offset), so the
+// gate, the perforations and the edge print can sit a hair off square, as they
+// do in a real scan.
+//
+// The Metal version is the reference; this is a line-for-line translation, so
+// the two should be diffed rather than reasoned about separately.
+layout(local_size_x = 256) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer FrameBuf { float v[]; } frame_data;
+layout(set = 0, binding = 1, std430) readonly buffer ParamBuf { float v[]; } P;
+layout(set = 0, binding = 2, std430) readonly buffer MetaBuf { uint v[]; } meta;
+layout(set = 0, binding = 3, std430) writeonly buffer OutBuf { float v[]; } out_data;
+
+// vulkan_gpu.cpp folds a dispatch past maxComputeWorkGroupCount[0] into rows of
+// workgroups; this is the 1D index it means.
+uint spk_global_index() {
+    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
+}
+
+const float kPi = 3.14159265358979323846;
+
+// enum OsP -- mirror of src/pipeline/overscan.cpp.
+const uint P_CW = 0u, P_CH = 1u, P_PX = 2u, P_FW = 3u, P_FH = 4u;
+const uint P_A00 = 5u, P_A01 = 6u, P_A10 = 7u, P_A11 = 8u, P_CS = 9u, P_CT = 10u, P_CU = 11u, P_CV = 12u;
+const uint P_VERTICAL = 13u;
+const uint P_GS0 = 14u, P_GT0 = 15u, P_GW = 16u, P_GH = 17u, P_CORNER = 18u, P_PENUMBRA = 19u;
+const uint P_WOB_A = 20u;   // 4 sides x 3 harmonics
+const uint P_WOB_PH = 32u;
+const uint P_FILM_W = 44u, P_FOG_AMP = 45u, P_FOG_WIDTH = 46u, P_FOG_SEED = 47u, P_FOG_PERIOD = 48u;
+const uint P_FOG_R = 49u, P_FOG_G = 50u, P_FOG_B = 51u;
+const uint P_N_LEAKS = 52u;
+const uint P_PERFORATED = 83u, P_PERF_PITCH = 84u, P_PERF_W = 85u, P_PERF_H = 86u, P_PERF_EDGE = 87u,
+           P_PERF_R = 88u, P_PERF_PHASE = 89u;
+const uint P_HOLE_C = 90u, P_HOLE_M = 91u, P_HOLE_Y = 92u;
+const uint P_FLARE_AMP = 93u, P_FLARE_WIDTH = 94u;
+const uint P_GATE_R = 95u;  // 4 corner radii: (s-,t-), (s+,t-), (s+,t+), (s-,t+)
+const uint P_N_Q = 99u, P_Q = 100u;
+const uint P_ROUGH_AMP = 180u, P_ROUGH_PERIOD = 181u, P_ROUGH_SEED = 182u;
+const uint P_HOLES_LIGHT = 183u, P_LIGHT_R = 184u, P_LIGHT_G = 185u, P_LIGHT_B = 186u;
+const uint P_PERF_SEED = 187u, P_LIGHT_FALL = 188u, P_LIGHT_DIR = 189u;
+const uint P_WALL_T = 190u, P_WALL_VS = 191u, P_WALL_VT = 192u, P_WALL_PAR = 193u,
+           P_BASE_R = 194u, P_BASE_G = 195u, P_BASE_B = 196u, P_WALL_GLOW = 197u, P_WALL_SCATTER = 198u;
+const uint P_CARRIER = 199u;
+const uint P_LEAKS = 200u;
+const uint P_PAIR_ADV = 260u;
+const uint kQStride = 10u;
+
+float p(uint i) { return P.v[i]; }
+
+vec2 canvas_to_film(float x, float y) {
+    const float u = (x + 0.5) * p(P_PX) - p(P_CU);
+    const float v = (y + 0.5) * p(P_PX) - p(P_CV);
+    return vec2(p(P_A00) * u + p(P_A01) * v + p(P_CS), p(P_A10) * u + p(P_A11) * v + p(P_CT));
+}
+
+uint hash_u(uint x) {
+    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
+    return x;
+}
+float hash_f(int i, uint seed) { return float(hash_u(uint(i) * 0x9E3779B9u ^ seed)) * (1.0 / 4294967295.0); }
+float value_noise(float x, uint seed) {
+    const float i0 = floor(x), f = x - i0;
+    const float w = f * f * (3.0 - 2.0 * f);
+    return mix(hash_f(int(i0), seed), hash_f(int(i0) + 1, seed), w);
+}
+
+// Signed distance to a convex quad (either winding; a repeated vertex makes a
+// triangle), negative inside.
+float sd_quad(vec2 pt, uint base) {
+    vec2 v[4] = {vec2(p(base + 0u), p(base + 1u)), vec2(p(base + 2u), p(base + 3u)),
+                 vec2(p(base + 4u), p(base + 5u)), vec2(p(base + 6u), p(base + 7u))};
+    float d = dot(pt - v[0], pt - v[0]);
+    float sgn = 1.0;
+    for (uint i = 0u, j = 3u; i < 4u; j = i, ++i) {
+        const vec2 e = v[j] - v[i], w = pt - v[i];
+        const float ee = dot(e, e);
+        if (ee < 1e-12) continue;
+        const vec2 b = w - e * clamp(dot(w, e) / ee, 0.0, 1.0);
+        d = min(d, dot(b, b));
+        const bool c0 = pt.y >= v[i].y, c1 = pt.y < v[j].y, c2 = e.x * w.y > e.y * w.x;
+        if ((c0 && c1 && c2) || (!c0 && !c1 && !c2)) sgn = -sgn;
+    }
+    return sgn * sqrt(d);
+}
+
+// The gate (RFC-032 §29): per-corner radii, convex quads added to or cut from
+// the opening, a machined edge's roughness, and each side's low-frequency
+// wobble. Signed distance, negative inside, in mm.
+float gate_sdf(vec2 st) {
+    const float hw = 0.5 * p(P_GW), hh = 0.5 * p(P_GH);
+    const float ds = st.x - (p(P_GS0) + hw), dt = st.y - (p(P_GT0) + hh);
+    const float r = ds > 0.0 ? (dt > 0.0 ? p(P_GATE_R + 2u) : p(P_GATE_R + 1u))
+                             : (dt > 0.0 ? p(P_GATE_R + 3u) : p(P_GATE_R + 0u));
+    const float qs = abs(ds) - (hw - r), qt = abs(dt) - (hh - r);
+    float d = length(max(vec2(qs, qt), vec2(0.0))) + min(max(qs, qt), 0.0) - r;
+    uint side; float along, len;
+    if (qs > qt) { side = ds > 0.0 ? 1u : 3u; along = dt + hh; len = 2.0 * hh; }
+    else         { side = dt > 0.0 ? 2u : 0u; along = ds + hw; len = 2.0 * hw; }
+    const float u = clamp(along / len, 0.0, 1.0);
+    float w = 0.0;
+    for (uint k = 0u; k < 3u; ++k)
+        w += p(P_WOB_A + side * 3u + k) * sin(float(k + 1u) * kPi * u + p(P_WOB_PH + side * 3u + k));
+    d -= w * sin(kPi * u);
+    const uint nq = uint(p(P_N_Q));
+    for (uint k = 0u; k < nq; ++k) {
+        const uint q = P_Q + kQStride * k;
+        float dq;
+        if (abs(p(q + 9u)) > 1.5) {
+            // an ellipse: centre q[0..1], radii q[2..3]; distance scaled by the
+            // smaller radius, exact on the boundary, which is all a penumbra reads
+            const vec2 rr = max(vec2(p(q + 2u), p(q + 3u)), vec2(1e-4));
+            dq = (length((st - vec2(p(q + 0u), p(q + 1u))) / rr) - 1.0) * min(rr.x, rr.y);
+        } else {
+            dq = sd_quad(st, q) - p(q + 8u);
+        }
+        d = p(q + 9u) > 0.0 ? min(d, dq) : max(d, -dq);
+    }
+    if (p(P_ROUGH_AMP) > 0.0) {
+        const uint seed = uint(p(P_ROUGH_SEED));
+        const float per = max(p(P_ROUGH_PERIOD), 1e-3);
+        d += p(P_ROUGH_AMP) * (value_noise(st.x / per, seed) + value_noise(st.y / per, seed ^ 0x5bd1e995u) - 1.0);
+    }
+    return d;
+}
+
+// The gate's shadow on the emulsion from a circular aperture: the lit fraction
+// of a disc of radius r cut by a straight edge at signed distance d.
+float penumbra_of(float d, float r) {
+    if (r <= 1e-6) return d < 0.0 ? 1.0 : 0.0;
+    const float u = clamp(-d / r, -1.0, 1.0);
+    return 0.5 + (u * sqrt(max(1.0 - u * u, 0.0)) + asin(u)) * (1.0 / kPi);
+}
+
+vec3 sample_frame(float fx, float fy, uint fw, uint fh) {
+    fx = clamp(fx, 0.0, float(fw) - 1.0);
+    fy = clamp(fy, 0.0, float(fh) - 1.0);
+    const uint x0 = uint(floor(fx)), y0 = uint(floor(fy));
+    const uint x1 = min(x0 + 1u, fw - 1u), y1 = min(y0 + 1u, fh - 1u);
+    const float ax = fx - float(x0), ay = fy - float(y0);
+    const uint i00 = 3u * (y0 * fw + x0), i01 = 3u * (y0 * fw + x1);
+    const uint i10 = 3u * (y1 * fw + x0), i11 = 3u * (y1 * fw + x1);
+    const vec3 a = vec3(frame_data.v[i00], frame_data.v[i00 + 1u], frame_data.v[i00 + 2u]);
+    const vec3 b = vec3(frame_data.v[i01], frame_data.v[i01 + 1u], frame_data.v[i01 + 2u]);
+    const vec3 c = vec3(frame_data.v[i10], frame_data.v[i10 + 1u], frame_data.v[i10 + 2u]);
+    const vec3 d = vec3(frame_data.v[i11], frame_data.v[i11 + 1u], frame_data.v[i11 + 2u]);
+    return mix(mix(a, b, ax), mix(c, d, ax), ay);
+}
+
+void main() {
+    const uint i = spk_global_index();
+    if (i >= meta.v[0]) return;
+    const uint cw = uint(p(P_CW));
+    const vec2 st = canvas_to_film(float(i % cw), float(i / cw));
+    const float W = p(P_FILM_W);
+    vec3 e = vec3(0.0);
+    if (p(P_CARRIER) > 1.5 || (st.y >= 0.0 && st.y <= W)) {
+        // A pair: past the middle of the gap, the second exposure of the same gate.
+        vec2 sg = st;
+        float shift = 0.0;
+        if (p(P_PAIR_ADV) > 0.0 && st.x > p(P_GS0) + 0.5 * (p(P_GW) + p(P_PAIR_ADV))) {
+            shift = p(P_PAIR_ADV);
+            sg.x -= shift;
+        }
+        const float cov = penumbra_of(gate_sdf(sg), p(P_PENUMBRA));
+        if (cov > 0.0) {
+            const float px = p(P_PX);
+            float fx, fy;
+            if (p(P_VERTICAL) < 0.5) { fx = (st.x - p(P_GS0)) / px - 0.5; fy = (st.y - p(P_GT0)) / px - 0.5; }
+            else                     { fx = (p(P_GT0) + p(P_GH) - st.y) / px - 0.5; fy = (st.x - p(P_GS0)) / px - 0.5; }
+            e += cov * sample_frame(fx, fy, uint(p(P_FW)), uint(p(P_FH)));
+        }
+        // Gate flare: the bevelled edge reflects scene light onto the film just
+        // outside the frame -- a thin line that follows the scene along the edge.
+        const float d_gate = gate_sdf(sg);
+        if (p(P_FLARE_AMP) > 0.0 && d_gate > -0.02 && d_gate < 6.0 * p(P_FLARE_WIDTH)) {
+            const float px = p(P_PX);
+            const float in_s = clamp(sg.x, p(P_GS0) + 0.12, p(P_GS0) + p(P_GW) - 0.12) + shift;
+            const float in_t = clamp(st.y, p(P_GT0) + 0.12, p(P_GT0) + p(P_GH) - 0.12);
+            float fx, fy;
+            if (p(P_VERTICAL) < 0.5) { fx = (in_s - p(P_GS0)) / px - 0.5; fy = (in_t - p(P_GT0)) / px - 0.5; }
+            else                     { fx = (p(P_GT0) + p(P_GH) - in_t) / px - 0.5; fy = (in_s - p(P_GS0)) / px - 0.5; }
+            const vec3 edge_light = sample_frame(fx, fy, uint(p(P_FW)), uint(p(P_FH)));
+            const float prof = exp(-max(d_gate, 0.0) / p(P_FLARE_WIDTH));
+            e += p(P_FLARE_AMP) * prof * edge_light;
+        }
+        // Edge fog: warm exposure decaying inward from each long edge, slowly
+        // varying along the length; and the spool leaks, seeded blobs on an edge.
+        const float d_top = max(st.y, 0.0), d_bot = max(W - st.y, 0.0);
+        const uint seed = uint(p(P_FOG_SEED));
+        const float period = max(p(P_FOG_PERIOD), 0.1);
+        const float nz = 0.6 * value_noise(st.x / period, seed) +
+                         0.4 * value_noise(st.x / (0.37 * period), seed ^ 0xA5A5A5A5u);
+        float fog = p(P_FOG_AMP) * exp(-min(d_top, d_bot) / max(p(P_FOG_WIDTH), 1e-3)) * (0.3 + 0.7 * nz);
+        const uint nl = uint(p(P_N_LEAKS));
+        for (uint k = 0u; k < nl; ++k) {
+            const uint b = P_LEAKS + 5u * k;
+            const float dd = p(b + 1u) < 0.5 ? d_top : d_bot;
+            const float ds = st.x - p(b);
+            fog += p(b + 2u) * exp(-ds * ds / (2.0 * p(b + 3u) * p(b + 3u))) * exp(-dd / p(b + 4u));
+        }
+        e += fog * vec3(p(P_FOG_R), p(P_FOG_G), p(P_FOG_B));
+    }
+    out_data.v[3u * i] = e.x;
+    out_data.v[3u * i + 1u] = e.y;
+    out_data.v[3u * i + 2u] = e.z;
+}
diff --git a/engine/src/shaders/vulkan/spk_overscan_film_present.comp b/engine/src/shaders/vulkan/spk_overscan_film_present.comp
new file mode 100644
index 0000000..90d86ea
--- /dev/null
+++ b/engine/src/shaders/vulkan/spk_overscan_film_present.comp
@@ -0,0 +1,125 @@
+#version 450
+
+// spk_overscan_film_present.comp -- the Vulkan translation of kernel ④ in
+// src/shaders/overscan.metal: where there is no film -- the perforations, and
+// outside the strip -- the negative's density goes to the cmy that cancels this
+// film's base, so the enlarger or the scanner sees clear light.
+//
+// `perf_sdf` / `film_alpha` are copied from the Metal source rather than
+// shared: shader includes would put a second file between the two ports, and
+// this one is 60 lines.
+layout(local_size_x = 256) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer CmyBuf { float v[]; } cmy;
+layout(set = 0, binding = 1, std430) readonly buffer ParamBuf { float v[]; } P;
+layout(set = 0, binding = 2, std430) readonly buffer MetaBuf { uint v[]; } meta;
+layout(set = 0, binding = 3, std430) writeonly buffer OutBuf { float v[]; } out_data;
+
+uint spk_global_index() {
+    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
+}
+
+// enum OsP -- mirror of src/pipeline/overscan.cpp.
+const uint P_CW = 0u, P_PX = 2u;
+const uint P_A00 = 5u, P_A01 = 6u, P_A10 = 7u, P_A11 = 8u, P_CS = 9u, P_CT = 10u, P_CU = 11u, P_CV = 12u;
+const uint P_FILM_W = 44u;
+const uint P_PERFORATED = 83u, P_PERF_PITCH = 84u, P_PERF_W = 85u, P_PERF_H = 86u, P_PERF_EDGE = 87u,
+           P_PERF_R = 88u, P_PERF_PHASE = 89u;
+const uint P_HOLE_C = 90u, P_HOLE_M = 91u, P_HOLE_Y = 92u;
+const uint P_PERF_SEED = 187u;
+const uint P_CARRIER = 199u;
+
+float p(uint i) { return P.v[i]; }
+
+vec2 canvas_to_film(float x, float y) {
+    const float u = (x + 0.5) * p(P_PX) - p(P_CU);
+    const float v = (y + 0.5) * p(P_PX) - p(P_CV);
+    return vec2(p(P_A00) * u + p(P_A01) * v + p(P_CS), p(P_A10) * u + p(P_A11) * v + p(P_CT));
+}
+
+uint hash_u(uint x) {
+    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
+    return x;
+}
+float hash_f(int i, uint seed) { return float(hash_u(uint(i) * 0x9E3779B9u ^ seed)) * (1.0 / 4294967295.0); }
+float value_noise(float x, uint seed) {
+    const float i0 = floor(x), f = x - i0;
+    const float w = f * f * (3.0 - 2.0 * f);
+    return mix(hash_f(int(i0), seed), hash_f(int(i0) + 1, seed), w);
+}
+
+// The nearest perforation's signed distance (mm, negative inside). KS holes are
+// punched to tight tolerances, not drawn: each hole sits a few microns off the
+// ideal pitch and row, is a few microns off size, its corners are not all the
+// same, and the punched edge is not a perfect line. `hole` returns the hole's
+// own hash (row and index) for the scan's dust.
+float perf_sdf(vec2 st, out uint hole) {
+    const float W = p(P_FILM_W);
+    const float pitch = p(P_PERF_PITCH), ph = p(P_PERF_PHASE);
+    // The nearest hole: the cell is centred on it.
+    const float k = floor((st.x - ph - 0.5 * p(P_PERF_W)) / pitch + 0.5);
+    const bool top = st.y < 0.5 * W;
+    const uint seed = uint(p(P_PERF_SEED));
+    hole = hash_u(uint(int(k) * 2 + (top ? 0 : 1)) * 0x9E3779B9u ^ seed);
+    const int h = int(hole & 0xFFFFu);
+    const float j0 = hash_f(h, seed ^ 0x1u) - 0.5, j1 = hash_f(h, seed ^ 0x2u) - 0.5;
+    const float j2 = hash_f(h, seed ^ 0x3u) - 0.5, j3 = hash_f(h, seed ^ 0x4u) - 0.5;
+    const float j4 = hash_f(h, seed ^ 0x5u) - 0.5;
+    const float wa = p(P_PERF_W) + 0.016 * j2, hc = p(P_PERF_H) + 0.016 * j3;
+    const float r = clamp(p(P_PERF_R) + 0.08 * j4, 0.3, 0.6);
+    const float sc = ph + k * pitch + 0.5 * p(P_PERF_W) + 0.020 * j0;
+    const float tc = (top ? p(P_PERF_EDGE) + 0.5 * p(P_PERF_H) : W - p(P_PERF_EDGE) - 0.5 * p(P_PERF_H)) + 0.024 * j1;
+    const vec2 q = abs(vec2(st.x - sc, st.y - tc)) - vec2(0.5 * wa - r, 0.5 * hc - r);
+    float d = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r;
+    // the punched edge: each hole's own roughness, 1-4 microns
+    const float rough = 0.001 + 0.003 * hash_f(h, seed ^ 0x6u);
+    d += rough * (value_noise(st.x / 0.05, seed ^ 0x77u) + value_noise(st.y / 0.05, seed ^ 0x99u) - 1.0) * 2.0;
+    // a burr or a chip on about one hole in four
+    if (hash_f(h, seed ^ 0x7u) < 0.25) {
+        const float ang = 6.2831853 * hash_f(h, seed ^ 0x8u);
+        const vec2 pb = vec2(sc, tc) + vec2(cos(ang) * 0.5 * wa, sin(ang) * 0.5 * hc);
+        const float sig = 0.020 + 0.030 * hash_f(h, seed ^ 0x9u);
+        const float amp = (hash_f(h, seed ^ 0xAu) < 0.5 ? -1.0 : 1.0) *
+                          (0.006 + 0.010 * hash_f(h, seed ^ 0xBu));
+        d += amp * exp(-dot(st - pb, st - pb) / (sig * sig));
+    }
+    return d;
+}
+
+// How soft a perforation's edge is in a scan, as the sigma of a Gaussian edge
+// in film millimetres (measured on reference_film/135, 2026-10-04).
+const float kHoleEdgeSigma = 0.017;
+
+// erf, Abramowitz and Stegun 7.1.26 (|error| < 1.5e-7).
+float erf_as(float x) {
+    const float t = 1.0 / (1.0 + 0.3275911 * abs(x));
+    const float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-x * x);
+    return x < 0.0 ? -y : y;
+}
+
+// Where there is film: 1 on the strip, 0 in the perforations and past its edges.
+float film_alpha(vec2 st) {
+    const float W = p(P_FILM_W), px = p(P_PX);
+    float a = p(P_CARRIER) > 1.5 ? 1.0 : clamp(min(st.y, W - st.y) / px + 0.5, 0.0, 1.0);
+    if (p(P_PERFORATED) > 0.5) {
+        uint hole;
+        // The hole's edge as the scan resolves it: the measured softness, and
+        // the pixel's own width (a one-pixel ramp is a sigma of 0.31 px).
+        const float sigma = sqrt(kHoleEdgeSigma * kHoleEdgeSigma + 0.0961 * px * px);
+        a *= 0.5 + 0.5 * erf_as(perf_sdf(st, hole) / (1.41421356 * sigma));
+    }
+    return a;
+}
+
+void main() {
+    const uint i = spk_global_index();
+    if (i >= meta.v[0]) return;
+    const uint cw = uint(p(P_CW));
+    const float a = film_alpha(canvas_to_film(float(i % cw), float(i / cw)));
+    const vec3 c = vec3(cmy.v[3u * i], cmy.v[3u * i + 1u], cmy.v[3u * i + 2u]);
+    const vec3 hole = vec3(p(P_HOLE_C), p(P_HOLE_M), p(P_HOLE_Y));
+    const vec3 r3 = a * c + (1.0 - a) * hole;
+    out_data.v[3u * i] = r3.x;
+    out_data.v[3u * i + 1u] = r3.y;
+    out_data.v[3u * i + 2u] = r3.z;
+}
diff --git a/engine/src/shaders/vulkan/spk_overscan_light.comp b/engine/src/shaders/vulkan/spk_overscan_light.comp
new file mode 100644
index 0000000..f1c2333
--- /dev/null
+++ b/engine/src/shaders/vulkan/spk_overscan_light.comp
@@ -0,0 +1,161 @@
+#version 450
+
+// spk_overscan_light.comp -- the Vulkan translation of kernel ⑤ in
+// src/shaders/overscan.metal (RFC-032 §30.5, §31): the scan's view of the
+// holes. Inside a hole: the picture's own white (holes = white) or a black
+// backing. Around it the cut wall: the punch shears the top of the base clean
+// and fractures the rest at a slant, so a scan seen a little off-axis sees a
+// band where the base thins from full to nothing.
+//
+// `perf_sdf` / `film_alpha` are copied from the Metal source; see the note in
+// spk_overscan_film_present.comp.
+layout(local_size_x = 256) in;
+
+layout(set = 0, binding = 0, std430) readonly buffer RgbBuf { float v[]; } rgb;
+layout(set = 0, binding = 1, std430) readonly buffer ParamBuf { float v[]; } P;
+layout(set = 0, binding = 2, std430) readonly buffer MetaBuf { uint v[]; } meta;
+layout(set = 0, binding = 3, std430) writeonly buffer OutBuf { float v[]; } out_data;
+
+uint spk_global_index() {
+    return gl_GlobalInvocationID.y * (gl_NumWorkGroups.x * gl_WorkGroupSize.x) + gl_GlobalInvocationID.x;
+}
+
+// enum OsP -- mirror of src/pipeline/overscan.cpp.
+const uint P_CW = 0u, P_PX = 2u;
+const uint P_A00 = 5u, P_A01 = 6u, P_A10 = 7u, P_A11 = 8u, P_CS = 9u, P_CT = 10u, P_CU = 11u, P_CV = 12u;
+const uint P_FILM_W = 44u;
+const uint P_PERFORATED = 83u, P_PERF_PITCH = 84u, P_PERF_W = 85u, P_PERF_H = 86u, P_PERF_EDGE = 87u,
+           P_PERF_R = 88u, P_PERF_PHASE = 89u;
+const uint P_HOLES_LIGHT = 183u, P_LIGHT_R = 184u, P_LIGHT_G = 185u, P_LIGHT_B = 186u;
+const uint P_PERF_SEED = 187u;
+const uint P_WALL_VS = 191u, P_WALL_VT = 192u, P_BASE_R = 194u, P_BASE_G = 195u, P_BASE_B = 196u,
+           P_WALL_GLOW = 197u, P_WALL_SCATTER = 198u;
+const uint P_CARRIER = 199u;
+
+float p(uint i) { return P.v[i]; }
+
+vec2 canvas_to_film(float x, float y) {
+    const float u = (x + 0.5) * p(P_PX) - p(P_CU);
+    const float v = (y + 0.5) * p(P_PX) - p(P_CV);
+    return vec2(p(P_A00) * u + p(P_A01) * v + p(P_CS), p(P_A10) * u + p(P_A11) * v + p(P_CT));
+}
+
+uint hash_u(uint x) {
+    x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16;
+    return x;
+}
+float hash_f(int i, uint seed) { return float(hash_u(uint(i) * 0x9E3779B9u ^ seed)) * (1.0 / 4294967295.0); }
+float value_noise(float x, uint seed) {
+    const float i0 = floor(x), f = x - i0;
+    const float w = f * f * (3.0 - 2.0 * f);
+    return mix(hash_f(int(i0), seed), hash_f(int(i0) + 1, seed), w);
+}
+
+// The nearest perforation's signed distance (mm, negative inside); see
+// spk_overscan_film_present.comp for the commentary.
+float perf_sdf(vec2 st, out uint hole) {
+    const float W = p(P_FILM_W);
+    const float pitch = p(P_PERF_PITCH), ph = p(P_PERF_PHASE);
+    const float k = floor((st.x - ph - 0.5 * p(P_PERF_W)) / pitch + 0.5);
+    const bool top = st.y < 0.5 * W;
+    const uint seed = uint(p(P_PERF_SEED));
+    hole = hash_u(uint(int(k) * 2 + (top ? 0 : 1)) * 0x9E3779B9u ^ seed);
+    const int h = int(hole & 0xFFFFu);
+    const float j0 = hash_f(h, seed ^ 0x1u) - 0.5, j1 = hash_f(h, seed ^ 0x2u) - 0.5;
+    const float j2 = hash_f(h, seed ^ 0x3u) - 0.5, j3 = hash_f(h, seed ^ 0x4u) - 0.5;
+    const float j4 = hash_f(h, seed ^ 0x5u) - 0.5;
+    const float wa = p(P_PERF_W) + 0.016 * j2, hc = p(P_PERF_H) + 0.016 * j3;
+    const float r = clamp(p(P_PERF_R) + 0.08 * j4, 0.3, 0.6);
+    const float sc = ph + k * pitch + 0.5 * p(P_PERF_W) + 0.020 * j0;
+    const float tc = (top ? p(P_PERF_EDGE) + 0.5 * p(P_PERF_H) : W - p(P_PERF_EDGE) - 0.5 * p(P_PERF_H)) + 0.024 * j1;
+    const vec2 q = abs(vec2(st.x - sc, st.y - tc)) - vec2(0.5 * wa - r, 0.5 * hc - r);
+    float d = length(max(q, vec2(0.0))) + min(max(q.x, q.y), 0.0) - r;
+    const float rough = 0.001 + 0.003 * hash_f(h, seed ^ 0x6u);
+    d += rough * (value_noise(st.x / 0.05, seed ^ 0x77u) + value_noise(st.y / 0.05, seed ^ 0x99u) - 1.0) * 2.0;
+    if (hash_f(h, seed ^ 0x7u) < 0.25) {
+        const float ang = 6.2831853 * hash_f(h, seed ^ 0x8u);
+        const vec2 pb = vec2(sc, tc) + vec2(cos(ang) * 0.5 * wa, sin(ang) * 0.5 * hc);
+        const float sig = 0.020 + 0.030 * hash_f(h, seed ^ 0x9u);
+        const float amp = (hash_f(h, seed ^ 0xAu) < 0.5 ? -1.0 : 1.0) *
+                          (0.006 + 0.010 * hash_f(h, seed ^ 0xBu));
+        d += amp * exp(-dot(st - pb, st - pb) / (sig * sig));
+    }
+    return d;
+}
+
+const float kHoleEdgeSigma = 0.017;
+
+float erf_as(float x) {
+    const float t = 1.0 / (1.0 + 0.3275911 * abs(x));
+    const float y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-x * x);
+    return x < 0.0 ? -y : y;
+}
+
+float film_alpha(vec2 st) {
+    const float W = p(P_FILM_W), px = p(P_PX);
+    float a = p(P_CARRIER) > 1.5 ? 1.0 : clamp(min(st.y, W - st.y) / px + 0.5, 0.0, 1.0);
+    if (p(P_PERFORATED) > 0.5) {
+        uint hole;
+        const float sigma = sqrt(kHoleEdgeSigma * kHoleEdgeSigma + 0.0961 * px * px);
+        a *= 0.5 + 0.5 * erf_as(perf_sdf(st, hole) / (1.41421356 * sigma));
+    }
+    return a;
+}
+
+void main() {
+    const uint i = spk_global_index();
+    if (i >= meta.v[0]) return;
+    const uint cw = uint(p(P_CW));
+    const vec2 st = canvas_to_film(float(i % cw), float(i / cw));
+    const float a = film_alpha(st);
+    const bool white = p(P_HOLES_LIGHT) > 0.5;
+    vec3 light = vec3(p(P_LIGHT_R), p(P_LIGHT_G), p(P_LIGHT_B));
+    vec3 c = vec3(rgb.v[3u * i], rgb.v[3u * i + 1u], rgb.v[3u * i + 2u]);
+    if (p(P_PERFORATED) > 0.5) {
+        uint hole;
+        const float d = perf_sdf(st, hole);
+        // The cut is not a perfectly vertical knife: the base is a little
+        // rounded where the punch went through, and a scan sees that as a soft
+        // shoulder just outside the hole.
+        const uint seed = uint(p(P_PERF_SEED));
+        const int h = int(hole & 0xFFFFu);
+        if (d > -0.03 && d < 0.15) {
+            const float e = 0.003;
+            uint hh0, hh1, hh2, hh3;
+            const float gx = perf_sdf(st + vec2(e, 0.0), hh0) - perf_sdf(st - vec2(e, 0.0), hh1);
+            const float gy = perf_sdf(st + vec2(0.0, e), hh2) - perf_sdf(st - vec2(0.0, e), hh3);
+            const vec2 g = vec2(gx, gy);
+            const vec2 nrm = g / max(length(g), 1e-6);
+            const vec2 vdir = vec2(p(P_WALL_VS), p(P_WALL_VT));
+            // how much this stretch of this hole's outline shows: per hole,
+            // patchy along the outline, a little more on the scan's leaning side
+            const float per_hole = 0.4 + 0.6 * hash_f(h, seed ^ 0xE1u);
+            const float patchy = smoothstep(0.25, 0.75, 0.5 * (value_noise(st.x / 0.35, seed ^ uint(h)) +
+                                                              value_noise(st.y / 0.35, seed ^ uint(h) ^ 0x3Cu)));
+            const float side = 0.6 + 0.8 * max(0.0, dot(nrm, vdir));
+            const float k = per_hole * patchy * side;
+            // the base's tint, mostly washed out
+            const vec3 tint = mix(vec3(1.0), vec3(p(P_BASE_R), p(P_BASE_G), p(P_BASE_B)), 0.3);
+            const float lam = p(P_WALL_SCATTER);
+            if (d >= 0.0) {
+                const float lift = p(P_WALL_GLOW) * k * exp(-d / lam);
+                c += lift * tint * (white ? light : vec3(1.0));
+            } else if (white && hash_f(h, seed ^ 0xE4u) < 0.5) {
+                light *= 1.0 - 0.12 * k * (1.0 - tint) * exp(d / 0.012);
+            }
+        }
+        if (white && d >= 0.0) {
+            // a faint flare from the hole's light into the film, on some holes
+            const float fl = 0.012 * hash_f(h, seed ^ 0xC4u) * step(0.5, hash_f(h, seed ^ 0xC5u));
+            c += fl * exp(-d / 0.025) * light;
+        }
+    }
+    // Past the film's long edges is the scan's carrier, not a hole.
+    const float W = p(P_FILM_W), px = p(P_PX);
+    const float on_strip = p(P_CARRIER) > 1.5 ? 1.0 : clamp(min(st.y, W - st.y) / px + 0.5, 0.0, 1.0);
+    const float in_film = on_strip > 0.0 ? a / on_strip : 0.0;
+    const vec3 r3 = mix(vec3(p(P_CARRIER)), mix(light, c, in_film), on_strip);
+    out_data.v[3u * i] = r3.x;
+    out_data.v[3u * i + 1u] = r3.y;
+    out_data.v[3u * i + 2u] = r3.z;
+}
