+        b.memory_type = direct_memory_type_;
+        b.memory_flags = memory_properties_.memoryTypes[direct_memory_type_].propertyFlags;
+        result = vkBindBufferMemory(device_, b.handle, b.memory, 0);
+        if (result == VK_SUCCESS) result = vkMapMemory(device_, b.memory, 0, VK_WHOLE_SIZE, 0, &b.mapped);
+        if (result != VK_SUCCESS || !b.mapped) {
